<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<YaOpt.CompatibilityDef>
		<defName>Core</defName>
		<threadLocalPatches>
			<ThreadLocalPatch>
				<method>RimWorld.QuestUtility:GetWorkDisabledQuestPart</method>
				<replace>tmpQuestWorkDisabled</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.QuestUtility:GetExtraFaction</method>
				<replace>tmpExtraFactions</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.QuestUtility:HasExtraHomeFaction</method>
				<parameters>
					<li>Verse.Pawn</li>
					<li>RimWorld.Faction</li>
				</parameters>
				<replace>tmpExtraFactions</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.QuestUtility:HasExtraMiniFaction</method>
				<parameters>
					<li>Verse.Pawn</li>
					<li>RimWorld.Faction</li>
				</parameters>
				<replace>tmpExtraFactions</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.QuestUtility:AppendInspectStringsFromQuestParts</method>
				<parameters>
					<li>System.Action(string, RimWorld.Quest)</li>
					<li>Verse.ISelectable</li>
					<li>out int</li>
				</parameters>
				<replace>tmpQuestParts</replace>
			</ThreadLocalPatch>
		</threadLocalPatches>
	</YaOpt.CompatibilityDef>
</Defs>