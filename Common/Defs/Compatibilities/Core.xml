<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<YaOpt.CompatibilityDef>
		<defName>Core</defName>
		
		<ignoredJobFailurePredicting>
			<li>Research</li> <!-- Can't validate job.Project -->
			<li>BuildRoof</li> <!-- Will use FloodFiller.FloodFill, which has a lock -->
		</ignoredJobFailurePredicting>
		
		<threadLocalPatches>
			<!-- QuestUtility -->
			<ThreadLocalPatch>
				<method>RimWorld.QuestUtility:GetWorkDisabledQuestPart</method>
				<replace>tmpQuestWorkDisabled</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.QuestUtility:GetExtraFaction</method>
				<replace>tmpExtraFactions</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.QuestUtility:HasExtraHomeFaction</method>
				<parameters>
					<li>Verse.Pawn</li>
					<li>RimWorld.Faction</li>
				</parameters>
				<replace>tmpExtraFactions</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.QuestUtility:HasExtraMiniFaction</method>
				<parameters>
					<li>Verse.Pawn</li>
					<li>RimWorld.Faction</li>
				</parameters>
				<replace>tmpExtraFactions</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.QuestUtility:AppendInspectStringsFromQuestParts</method>
				<parameters>
					<li>System.Action(string, RimWorld.Quest)</li>
					<li>Verse.ISelectable</li>
					<li>out int</li>
				</parameters>
				<replace>tmpQuestParts</replace>
			</ThreadLocalPatch>
			
			<!-- AttackTargetsCache -->
			<ThreadLocalPatch>
				<method>Verse.AI.AttackTargetsCache:GetPotentialTargetsFor</method>
				<replace>targets</replace>
			</ThreadLocalPatch>
			
			<!-- AttackTargetsCache -->
			<ThreadLocalPatch>
				<method>RimWorld.Pawn_MeleeVerbs:GetUpdatedAvailableVerbsList</method>
				<replace>meleeVerbs</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.Pawn_MeleeVerbs:GetUpdatedAvailableVerbsList</method>
				<replace>verbsToAdd</replace>
			</ThreadLocalPatch>

			<!-- Verb -->
			<ThreadLocalPatch>
				<method>Verse.Verb:TryFindShootLineFromTo</method>
				<replace>tempLeanShootSources</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>Verse.Verb:CanHitFromCellIgnoringRange</method>
				<replace>tempDestList</replace>
			</ThreadLocalPatch>
			
			<!-- StorageGroup -->
			<ThreadLocalPatch>
				<method>RimWorld.StorageGroup:get_CellsList</method>
				<replace>tmpCellsList</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.StorageGroup:get_HaulSourcesList</method>
				<replace>tmpHaulSourceList</replace>
			</ThreadLocalPatch>
			
			<!-- World -->
			<ThreadLocalPatch>
				<method>RimWorld.Planet.World:NaturalRockTypesIn</method>
				<replace>tmpNaturalRockDefs</replace>
			</ThreadLocalPatch>
			
			<!-- CellFinder -->
			<ThreadLocalPatch>
				<method>Verse.CellFinder:TryFindRandomCell</method>
				<replace>workingCells</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>Verse.CellFinder:TryFindRandomCellInRegion</method>
				<replace>workingCells</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>Verse.CellFinder:TryFindRandomCellNear</method>
				<replace>workingListX</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>Verse.CellFinder:TryFindRandomCellNear</method>
				<replace>workingListZ</replace>
			</ThreadLocalPatch>
			
			<!-- RCellFinder -->
			<ThreadLocalPatch>
				<method>RimWorld.RCellFinder:RandomWanderDestFor</method>
				<replace>regions</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.RCellFinder:FindBestAngleAvoidingSpots</method>
				<replace>tmpSpotsToAvoid</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.RCellFinder:TryFindRandomSpotNearAvoidingHostilePawns</method>
				<replace>tmpSpotsToAvoid</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.RCellFinder:TryFindEdgeCellWithPathToPositionAvoidingColony</method>
				<replace>tmpSpotsToAvoid</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.RCellFinder:TryFindEdgeCellFromPositionAvoidingColony</method>
				<replace>tmpSpotsToAvoid</replace>
			</ThreadLocalPatch>
			<ThreadLocalPatch>
				<method>RimWorld.RCellFinder:TryFindEdgeCellFromPositionAvoidingColony</method>
				<replace>tmpEdgeCells</replace>
			</ThreadLocalPatch>
			
			<!-- JobGiver_AITrashBuildingsDistant -->
			<ThreadLocalPatch>
				<method>RimWorld.JobGiver_AITrashBuildingsDistant:TryGiveJob</method>
				<replace>tmpTrashableBuildingCandidates</replace>
			</ThreadLocalPatch>
		</threadLocalPatches>
		
		<lockPatches>
			<!-- BodyDef -->
			<LockPatch>
				<method>Verse.BodyDef:ClearCachedData</method>
			</LockPatch>
			<LockPatch>
				<method>Verse.BodyDef:GetPartsWithDef</method>
			</LockPatch>
			<LockPatch>
				<method>Verse.BodyDef:GetPartsWithTag</method>
			</LockPatch>
			
			<!-- Room -->
			<LockPatch>
				<method>Verse.Room:GetRoomRoleIfBuildingPlaced</method>
			</LockPatch>
			<LockPatch>
				<method>Verse.Room:GetStat</method>
			</LockPatch>
			<LockPatch>
				<method>Verse.Room:get_Role</method>
				<scope>Method</scope> <!-- Many RoomRoleWorkers use shared static fields -->
			</LockPatch>
			
			<!-- TileTemperaturesComp -->
			<!-- Fixed a bug caused by a race condition in TileTemperaturesComp.RetrieveCachedData. -->
			<LockPatch>
				<method>RimWorld.Planet.TileTemperaturesComp:WorldComponentTick</method>
				<scope>Type</scope>
			</LockPatch>
			<LockPatch>
				<method>RimWorld.Planet.TileTemperaturesComp:RetrieveCachedData</method>
				<scope>Type</scope>
			</LockPatch>
			
			<!-- CostListCalculator -->
			<LockPatch>
				<method>RimWorld.CostListCalculator:CostListAdjusted</method>
				<parameters>
					<li>Verse.BuildableDef</li>
					<li>Verse.ThingDef</li>
					<li>bool</li>
				</parameters>
			</LockPatch>
			
			<!-- FleeUtility -->
			<!-- No known multithreading conflict yet. Just a precaution. -->
			<LockPatch>
				<method>RimWorld.FleeUtility:FleeJob</method>
			</LockPatch>
			
			<!-- GenConstruct -->
			<LockPatch>
				<method>RimWorld.GenConstruct:CanConstruct</method>
				<parameters>
					<li>Verse.Thing</li>
					<li>Verse.Pawn</li>
					<li>bool</li>
					<li>bool</li>
					<li>Verse.JobDef</li>
				</parameters>
			</LockPatch>
			
			<!-- ItemAvailability -->
			<LockPatch>
				<method>RimWorld.ItemAvailability:ThingsAvailableAnywhere</method>
			</LockPatch>
			
			<!-- ListerArtificialBuildingsForMeditation -->
			<LockPatch>
				<method>RimWorld.ListerArtificialBuildingsForMeditation:GetForCell</method>
			</LockPatch>
			
			<!-- ListerBuildingWithTagInProximity -->
			<LockPatch>
				<method>RimWorld.ListerBuildingWithTagInProximity:GetForCell</method>
			</LockPatch>
			
			<!-- ListerBuldingOfDefInProximity -->
			<LockPatch>
				<method>RimWorld.ListerBuldingOfDefInProximity:GetForCell</method>
				<parameters>
					<li>Verse.IntVec3</li>
					<li>float</li>
					<li>System.Collections.Generic.List(RimWorld.MeditationFocusOffsetPerBuilding)</li>
					<li>Verse.Thing</li>
				</parameters>
				<scope>Type</scope>
			</LockPatch>
			<LockPatch>
				<method>RimWorld.ListerBuldingOfDefInProximity:GetForCell</method>
				<parameters>
					<li>Verse.IntVec3</li>
					<li>float</li>
					<li>Verse.ThingDef</li>
					<li>Verse.Thing</li>
				</parameters>
				<scope>Type</scope>
			</LockPatch>
			
			<!-- MemoryThoughtHandler -->
			<LockPatch>
				<method>RimWorld.MemoryThoughtHandler:TryGainMemory</method>
				<parameters>
					<li>RimWorld.Thought_Memory</li>
					<li>Verse.Pawn</li>
				</parameters>
				<supportRecursion>true</supportRecursion>
			</LockPatch>
			
			<!-- CastPositionFinder -->
			<LockPatch>
				<method>Verse.AI.CastPositionFinder:TryFindCastPosition</method>
			</LockPatch>
		
			<!-- AutoSlaughterManager -->
			<LockPatch>
				<method>Verse.AutoSlaughterManager:get_AnimalsToSlaughter</method>
			</LockPatch>
			
			<!-- CellFinder -->
			<LockPatch>
				<method>Verse.CellFinder:TryFindRandomAdjacentCell</method>
			</LockPatch>
			<LockPatch>
				<method>Verse.CellFinder:TryFindRandomEdgeCellWith</method>
				<parameters>
					<li>System.Predicate(Verse.IntVec3)</li>
					<li>Verse.Map</li>
					<li>Verse.Rot4</li>
					<li>float</li>
					<li>out Verse.IntVec3</li>
				</parameters>
			</LockPatch>
			<LockPatch>
				<method>Verse.CellFinder:FindNoWipeSpawnLocNear</method>
			</LockPatch>
			<LockPatch>
				<method>Verse.CellFinder:TryFindBestPawnStandCell</method>
			</LockPatch>
			<LockPatch>
				<method>Verse.CellFinder:TryFindRandomCellInsideWith</method>
			</LockPatch>
			
			<!-- RCellFinder -->
			<LockPatch>
				<method>RimWorld.RCellFinder:TryFindRandomSpotJustOutsideColony</method>
				<parameters>
					<li>Verse.IntVec3</li>
					<li>Verse.Map</li>
					<li>Verse.Pawn</li>
					<li>out Verse.IntVec3</li>
					<li>System.Predicate(Verse.IntVec3)</li>
				</parameters>
			</LockPatch>
			<LockPatch>
				<method>RimWorld.RCellFinder:TryFindGatheringSpot</method>
			</LockPatch>
			<LockPatch>
				<method>RimWorld.RCellFinder:TryFindAllowedUnroofedSpotOutsideColony</method>
			</LockPatch>
			
			<!-- District -->
			<LockPatch>
				<method>Verse.District:OpenRoofCountStopAt</method>
			</LockPatch>
			
			<!-- FloodFiller -->
			<LockPatch>
				<method>Verse.FloodFiller:FloodFill</method>
				<parameters>
					<li>Verse.IntVec3</li>
					<li>System.Predicate(Verse.IntVec3)</li>
					<li>System.Func(Verse.IntVec3, int, bool)</li>
					<li>int</li>
					<li>bool</li>
					<li>System.Collections.Generic.IEnumerable(Verse.IntVec3)</li>
				</parameters>
			</LockPatch>
			
			<!-- GenAdj -->
			<LockPatch>
				<method>Verse.GenAdj:TryFindRandomAdjacentCell8WayWithRoom</method>
				<parameters>
					<li>Verse.IntVec3</li>
					<li>Verse.Rot4</li>
					<li>Verse.IntVec2</li>
					<li>Verse.Map</li>
					<li>out Verse.IntVec3</li>
				</parameters>
			</LockPatch>
			
			<!-- GenSight -->
			<!-- No known multithreading conflict yet. Just a precaution. -->
			<LockPatch>
				<method>Verse.GenSight:BresenhamCellsBetween</method>
				<parameters>
					<li>int</li>
					<li>int</li>
					<li>int</li>
					<li>int</li>
				</parameters>
			</LockPatch>
			
			<!-- GrammarResolverSimple -->
			<LockPatch>
				<method>Verse.GrammarResolverSimple:Formatted</method>
				<supportRecursion>true</supportRecursion>
			</LockPatch>
			
			<!-- PawnCapacitiesHandler -->
			<LockPatch>
				<method>Verse.PawnCapacitiesHandler:GetLevel</method>
			</LockPatch>
			
			<!-- RegionTraverser -->
			<LockPatch>
				<method>Verse.RegionTraverser:MarkRegionsBFS</method>
			</LockPatch>
		</lockPatches>
	</YaOpt.CompatibilityDef>
</Defs>