<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- While you're up 1.6 -->
	<YaOpt.CompatibilityDef MayRequire="zsbk.patch16.whileyoureup">
		<defName>WhileYoureUp</defName>
		<workGiverCompatibilities>
			<WorkGiverCompatibility>
				<workGiverClass>RimWorld.WorkGiver_ConstructDeliverResources</workGiverClass>
				<parallelism>MainThreaded</parallelism>
			</WorkGiverCompatibility>
		</workGiverCompatibilities>
	</YaOpt.CompatibilityDef>
	
